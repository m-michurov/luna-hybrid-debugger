#!/usr/bin/bash

if [[ -z "${LUNA_HYBRID_DEBUGGER_HOME}" ]]; then
  SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
  LUNA_HYBRID_DEBUGGER_HOME="$SCRIPT_DIR"
fi

PYTHONPATH=$LUNA_HOME/scripts:$PYTHONPATH "$LUNA_HYBRID_DEBUGGER_HOME/.venv/bin/python3" "$LUNA_HYBRID_DEBUGGER_HOME"/luna-hybrid-debugger.py "$@"
