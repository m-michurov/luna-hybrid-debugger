import c_gemv_f4x4_f4(value, value, name) as gemv;
import c_print_f4(value) as print_f4;
import c_init_f4(name, real, real, real, real) as init_f4;

C++ sub set_int(name x, int v) ${{ x = v; $}}

sub main() {
    df mat, vec, result, N, M;

    set_int(N, 3);
    set_int(M, 4);

    for i = 1..N {
        cf b[i ] : init_f4 ( mat[i], i*1.5, i*1.5, i*1.5, i*1.5 ) ; // ()
        init_f4(vec[i], i*1, i*2, i*3, i*4);
        cf a[i]: gemv(mat[i], vec[i], result[i]);
    }

    for k = 1..M {
        print_f4 (result[k]);
    }
}