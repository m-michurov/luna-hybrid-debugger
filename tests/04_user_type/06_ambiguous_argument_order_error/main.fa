import c_gemv_f4x4_f4(value, value, name) as gemv;
import c_print_f4(value) as print_f4;
import c_init_f4(name, real, real, real, real) as init_f4;
import c_init_f4x4_identity(name) as init_f4x4_identity;
import c_scale_f4x4(value, real, name) as scale_f4x4;

sub main() {
    df identity, identity_scaled, vec, result;

    init_f4(vec, 1, 2, 3, 4);
    init_f4x4_identity(identity);
    scale_f4x4(identity, 1.5, identity_scaled);
    gemv(vec, identity_scaled, result);
    print_f4(result);
}