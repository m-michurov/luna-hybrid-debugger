#!/usr/bin/env python3

from work_json_file import read_json_file

plugin_list = []

plugins_data = read_json_file("build/plugins_config.json")
for plugin_info in plugins_data:
	if "name" not in plugin_info:
		continue
	if "enable" not in plugin_info:
		continue
	if "type" not in plugin_info or plugin_info["type"] != "ThreadPool":
		continue
	if plugin_info["enable"] != "true":
		continue
	plugin_list += [plugin_info["name"]]

print("#include <vector>")
print("#include \"common.h\"")
print("#include \"plugin_list_container.h\"")
print("")

for plugin in plugin_list:
	print("extern \"C\" AbstractThreadPoolPlugin *", plugin, "_create_plugin();", sep='')

print()
print("extern \"C\" PluginListContainer *get_threadpool_plugin_list() {")
print("\tPluginListContainer *list = new PluginListContainer();")
print("\tif (list == nullptr) ABORT(\"failed to create plugin list container\");")

for plugin in plugin_list:
	print("\tAbstractThreadPoolPlugin *", plugin, "_pool = ", plugin, "_create_plugin();", sep='')
	print("\tif(", plugin, "_pool == nullptr) ABORT(\"failed to create plugin class for \\\"", plugin, "\\\"\");", sep='')
	print("\tlist->add_plugin(", plugin, "_pool);", sep='')

print("\treturn list;")
print("}\n")
