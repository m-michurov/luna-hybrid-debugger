#!/usr/bin/env python3

import subprocess, os, sys
from work_json_file import read_json_file

plugin_names=[]
plugin_makefiles=[]

plugins_data = read_json_file("build/plugins_config.json")
for plugin_info in plugins_data:
	if "name" not in plugin_info:
		continue
	if "enable" not in plugin_info:
		continue
	if plugin_info["enable"] != "true":
		continue
	dir_name = plugin_info["name"]
	plugin_makefile = "plugins/" + dir_name + "/local/Makefile"
	if os.path.isfile(plugin_makefile):
		plugin_names+=[dir_name+"/local"]
		plugin_makefiles+=[plugin_makefile]
	plugin_makefile = "plugins/" + dir_name + "/global/Makefile"
	if os.path.isfile(plugin_makefile):
		plugin_names+=[dir_name+"/global"]
		plugin_makefiles+=[plugin_makefile]
print("default:", ' '.join(plugin_makefiles))
if len(plugin_names)==0:
    print("\techo \"No plugins available\"")
else:
    for plugin in plugin_names:
        print("\tcd plugins/",plugin,"; make", sep='')

print()
print('clean:')
if len(plugin_names)==0:
    print("\techo \"No plugins available\"")
else:
    for plugin in plugin_names:
        print("\tcd plugins/",plugin,"; make clean", sep='')
